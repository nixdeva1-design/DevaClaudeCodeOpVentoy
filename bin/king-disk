#!/usr/bin/env bash
# king-disk - Zet je in je werkplek op de Ventoy USB (king schijf)
#
# Alles staat op de USB. Dit script vindt de Ventoy data-partitie
# en zet je er direct in.

set -euo pipefail

MOUNT="/mnt/king"

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
R='\033[0m'

# Vind de Ventoy data-partitie (label: ventoy)
vind_ventoy() {
  if [[ -e /dev/disk/by-label/ventoy ]]; then
    readlink -f /dev/disk/by-label/ventoy
    return
  fi
  lsblk -rno NAME,LABEL 2>/dev/null \
    | awk '$2=="ventoy"{print "/dev/"$1}' \
    | head -1
}

# Mount als dat nog niet is gebeurd
zorg_voor_mount() {
  local part="$1"
  if mountpoint -q "$MOUNT" 2>/dev/null; then
    return  # Al gemount
  fi
  if [[ $EUID -ne 0 ]]; then
    sudo mkdir -p "$MOUNT"
    sudo mount "$part" "$MOUNT"
  else
    mkdir -p "$MOUNT"
    mount "$part" "$MOUNT"
  fi
}

case "${1:-}" in

  # Ga naar de USB werkplek
  ""| go | open | hier)
    part=$(vind_ventoy)
    if [[ -z "$part" ]]; then
      echo -e "${RED}King schijf (Ventoy USB) niet gevonden.${R}"
      exit 1
    fi
    zorg_voor_mount "$part"
    echo -e "${GREEN}King schijf: $part gemount op $MOUNT${R}"
    cd "$MOUNT"
    echo -e "${BOLD}Je bent nu in je werkplek op de USB:${R} $MOUNT"
    exec "${SHELL:-bash}"
    ;;

  # Toon wat er op de USB staat
  ls | lijst | inhoud)
    part=$(vind_ventoy)
    [[ -z "$part" ]] && { echo -e "${RED}USB niet gevonden.${R}"; exit 1; }
    zorg_voor_mount "$part"
    ls -lah "$MOUNT"
    ;;

  # Toon de status
  status)
    part=$(vind_ventoy)
    if [[ -z "$part" ]]; then
      echo -e "${RED}Ventoy USB niet gevonden.${R}"
    else
      echo -e "${GREEN}Ventoy USB:${R} $part"
      if mountpoint -q "$MOUNT" 2>/dev/null; then
        echo -e "${GREEN}Gemount op:${R} $MOUNT"
        df -h "$MOUNT" | tail -1
      else
        echo -e "${YELLOW}Nog niet gemount. Voer uit: king-disk${R}"
      fi
    fi
    ;;

  # Ontkoppel
  stop | umount)
    if mountpoint -q "$MOUNT" 2>/dev/null; then
      [[ $EUID -ne 0 ]] && sudo umount "$MOUNT" || umount "$MOUNT"
      echo -e "${GREEN}USB ontkoppeld.${R}"
    else
      echo "Niet gemount."
    fi
    ;;

  -h | --help | help)
    echo -e "${BOLD}king-disk${R} — ga naar je werkplek op de Ventoy USB"
    echo ""
    echo "  king-disk          Mount USB en open shell in je werkplek"
    echo "  king-disk status   Toon status van de USB"
    echo "  king-disk ls       Toon inhoud van de USB"
    echo "  king-disk stop     Ontkoppel de USB"
    ;;

  *)
    echo -e "${RED}Onbekend: $1${R}"
    echo "Gebruik: king-disk [status|ls|stop]"
    exit 1
    ;;
esac
